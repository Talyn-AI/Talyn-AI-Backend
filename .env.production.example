# Production configuration for Talyn.
#
# Copy to `.env` next to docker-compose.yml and fill in every value marked
# REQUIRED. Nothing here has a safe default — a blank secret should fail the
# deploy, not silently weaken it.
#
# Secrets manager: prefer injecting these from AWS Secrets Manager, Doppler,
# or your host's env store rather than committing this file. The compose file
# reads them as ${VAR}, so a host-level environment works unchanged.

# ── Required: never ship a placeholder ───────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Postgres superuser password. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Required for taking real money ───────────────────────────────────────────
# Paystack live secret key (sk_live_...). Without it the stub provider
# auto-succeeds purchases, which the app refuses to do outside dev.
PAYSTACK_SECRET_KEY=
# Public origin Paystack redirects back to after checkout.
PAYMENT_RETURN_URL=https://app.your-domain.com
# Only if you use a separate webhook key.
PAYSTACK_WEBHOOK_SECRET=

# ── Required for sign-in and uploads ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Leave empty for AWS S3 itself; set for Cloudflare R2 / MinIO / Backblaze.
S3_ENDPOINT=

# ── Required for transactional email ─────────────────────────────────────────
# Until SMTP is set, password reset fails closed and returns no token.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=


ALLOW_STUB_PAYMENTS=false

# ── Required for a live AI coach ─────────────────────────────────────────────
# Without this the coach returns canned responses.
ANTHROPIC_API_KEY=
# ── Topology ─────────────────────────────────────────────────────────────────
ENVIRONMENT=prod
DEBUG=false

# Compose service names. Change these if you move services.
BACKEND_URL=http://backend:8000
# NB: no bare COACH_URL here. Nothing reads it; the browser reaches the coach
# through VITE_COACH_URL below, and nginx routes /coach by container name.

# Your public web hostname, used for email links (password reset) and as the
# Paystack redirect fallback. Point it at wherever the UI runs — even a local
# address while no frontend is deployed. Email links are built from this, so
# a wrong value here means reset emails lead nowhere.
PUBLIC_WEB_URL=https://app.your-domain.com
# NB: there is deliberately no PUBLIC_API_URL. It was here and nothing read
# it — the API host is API_HOST below, and callers reach it through
# VITE_API_URL / direct HTTPS.

# Browser origins allowed to call the API directly. There is no same-origin
# frontend container, so every browser call is cross-origin and this list is
# load-bearing — an origin missing here gets a CORS rejection, not data.
# List the UI origin(s), even local ones used for testing.
CORS_ORIGINS=https://app.your-domain.com,https://api.your-domain.com

# Hostname Caddy terminates TLS for and routes /v1 + coach prefixes on.
# There is deliberately no WEB_HOST: no browser UI is served, so there is no
# second hostname. If a frontend is deployed again, re-add it with a web
# container in front (git history shows the shape).
API_HOST=api.your-domain.com

# ── Runtime ──────────────────────────────────────────────────────────────────
# Postgres is internal-only: not published to the host at all.
POSTGRES_USER=
POSTGRES_DB=

# Shared rate-limit counters. Required with more than one backend replica:
# in-memory counters are per-process, so N workers would each allow the full
# budget and multiply your effective limit by N.
REDIS_URL=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=300

# ── AI coach ─────────────────────────────────────────────────────────────────
# Leave TALYN_MOCK empty in production. Any other value means canned replies.
TALYN_MOCK=
# Browsers allowed to call the coach. This must be your own origin — the
# coach bills a real API on every call, so an open CORS is an open wallet.
CORS_ORIGINS=https://app.your-domain.com
# The coach requires a backend JWT on every call unless TALYN_MOCK is set,
# so nobody can spend the account without an account. Leave empty.
TALYN_REQUIRE_TOKEN=
COACH_RATE_LIMIT_PER_MINUTE=30

# ── Frontend (not deployed) ────────────────────────────────────────────────
# No frontend is pushed or deployed, so nothing reads these. They are Vite
# build args for the removed `web` service, kept here so re-adding the UI is
# uncommenting rather than reconstructing. Leave commented until then.
# VITE_API_URL=https://api.your-domain.com
# VITE_COACH_URL=https://api.your-domain.com
# Google sign-in is built from GOOGLE_CLIENT_ID above, NOT a VITE_-prefixed
# name. Compose used to map that one value into the web build args. An
# earlier draft of this file listed VITE_GOOGLE_CLIENT_ID, which compose
# never read — so the sign-in button silently rendered with no client id and
# no error.

# ── Uploads ──────────────────────────────────────────────────────────────────
# Ceilings are enforced by a content-length-range in the presigned POST
# policy, so they hold even against a client that ignores the UI.
MAX_THUMBNAIL_BYTES=5242880
MAX_VIDEO_BYTES=536870912
MAX_RESOURCE_BYTES=104857600
MAX_PROFILE_IMAGE_BYTES=2097152
S3_SERVER_SIDE_ENCRYPTION=AES256
# Abandoned uploads are invisible in the app and cost storage forever.
# Schedule `python -m scripts.cleanup_orphans` from cron.
ORPHAN_UPLOAD_TTL_HOURS=24
# Malware scanning. Empty = uploads are accepted unscanned, and recorded as
# "unscanned" rather than "clean".
CLAMAV_HOST=
CLAMAV_PORT=
# true = refuse uploads when the scanner cannot reach a verdict. That keeps
# uploads working through a scanner outage when false; only enable it once
# the scanner host is reliable, or you will block creators during downtime.
UPLOAD_SCANNING_REQUIRED=false

# ── Backups ──────────────────────────────────────────────────────────────────
# Where database dumps land on the host. The default is ./backups, which
# sits on the same disk as the database it protects — a disk failure takes
# both, and the backups are worthless at exactly the moment they are needed.
# Point this at a mounted volume or a second disk.
BACKUP_DIR=
# How many dumps to keep. Each run also verifies the newest dump by restoring
# it into a scratch database and comparing row counts, and deletes the dump
# if that fails.
BACKUP_KEEP=

# ── TLS ──────────────────────────────────────────────────────────────────────
# Caddy handles certificates: set ACME_EMAIL, point API_HOST DNS
# at this host, and certs are issued and renewed on their own over HTTP-01.
# Nothing else in the stack needs a certificate or a public port.
ACME_EMAIL=ops@your-domain.com
