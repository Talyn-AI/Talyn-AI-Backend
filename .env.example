DATABASE_URL=
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
# Required — the app refuses to start without SECRET_KEY set.
SECRET_KEY=change-me-to-a-strong-random-value
# Google OAuth (sign-in). Empty = /v1/auth/google fails closed.
GOOGLE_CLIENT_ID=
# Paystack (NGN). Empty = stub provider that auto-succeeds every purchase,
# which collects no money. Fine in dev; staging/prod refuse to boot this way
# unless ALLOW_STUB_PAYMENTS=true. Use test keys (sk_test_...) while wiring up.
PAYSTACK_SECRET_KEY=
# Separate key for webhook signatures. Empty = reuse PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
# Override the provider API (e.g. a self-hosted mock). Empty = Paystack.
PAYSTACK_API_URL=
# Where Paystack redirects the learner after paying. Empty = FRONTEND_URL.
PAYMENT_RETURN_URL=
# Only for demos with no provider account. Never set this in production.
ALLOW_STUB_PAYMENTS=false
DEBUG=false
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
# Transactional email (welcome, password reset, purchase receipt). Leave
# SMTP_HOST empty to disable (dev then returns the reset token inline).
# Any SMTP provider works: Resend, Postmark, SendGrid, SES, Mailgun, Gmail.
# Port 587 = STARTTLS, 465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
# Object storage (videos, thumbnails, resources). Empty bucket = disabled.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Encryption applied to every uploaded object.
S3_SERVER_SIDE_ENCRYPTION=
# Upload ceilings, enforced by the storage provider via the presigned POST
# policy (not by the client).
MAX_THUMBNAIL_BYTES=5242880
MAX_VIDEO_BYTES=536870912
MAX_RESOURCE_BYTES=104857600
MAX_PROFILE_IMAGE_BYTES=2097152
# How long an uploaded-but-never-attached object survives the orphan sweep.
ORPHAN_UPLOAD_TTL_HOURS=24
# Malware scanning. Empty host = off (assets record "unscanned").
# Set to a ClamAV clamd host to scan every attach.
CLAMAV_HOST=
CLAMAV_PORT=
# true = refuse uploads when the scanner cannot reach a verdict.
UPLOAD_SCANNING_REQUIRED=false
# Rate limiting (per IP, 60s windows)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=300
# Shared counters for multi-worker deployments. Empty = in-memory.
REDIS_URL=